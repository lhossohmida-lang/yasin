{
  "name": "mens-store-app",
  "version": "1.0.0",
  "description": "Desktop Application for Men's Clothing Store Management",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Yasin",
  "license": "ISC",
  "build": {
    "appId": "com.yasin.mens-store",
    "productName": "أناقة للرجال",
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "أناقة-للرجال.exe"
    },
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "script.js",
      "shop.html",
      "shop.css",
      "shop.js",
      "icon.png"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
